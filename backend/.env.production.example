PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://replace-with-your-domain.example
APP_PUBLIC_URL=https://replace-with-your-domain.example

# Obligatorio en produccion. Generar un valor largo y aleatorio.
SESSION_SECRET=replace-with-a-long-random-secret

# Bootstrap opcional solo para primera instalacion o recuperacion segura.
# Definir valores reales solo en backend/.env.production o como variables del servidor.
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Admin temporal solo para pruebas controladas.
ENABLE_TEST_ADMIN=0
DISABLE_TEST_ADMIN_ON_START=1
TEST_ADMIN_USER=admin
TEST_ADMIN_EMAIL=admin@facturapp.local
TEST_ADMIN_PASSWORD=
TEST_ADMIN_NAME=Administrador Pruebas

# Produccion PostgreSQL con Docker Compose: usar el servicio interno postgres.
# El password debe coincidir con POSTGRES_PASSWORD.
DATABASE_URL=postgresql://factuflow:replace-with-a-secure-postgres-password@postgres:5432/factuflow
ALLOW_EMPTY_DB_CHECK=0

# PostgreSQL opcional para validar migraciones/checks o usar una base externa.
POSTGRES_DB=factuflow
POSTGRES_USER=factuflow
POSTGRES_PASSWORD=replace-with-a-secure-postgres-password
PGSSLMODE=disable

# UF
UF_API_BASE=https://mindicador.cl/api/uf
UF_SII_BASE=https://www.sii.cl/valores_y_fechas/uf
UF_CACHE_TTL_HOURS=24
UF_CACHE_FROM_YEAR=2026
UF_CACHE_TO_YEAR=2026

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
