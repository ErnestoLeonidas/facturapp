# Servidor
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me

# Base de datos SQLite
# Local/desarrollo: archivo dentro de backend/storage (ignorado por git).
DB_PATH=./storage/facturapp.sqlite
# Produccion: usar una ruta en volumen persistente del hosting/VPS.
# DB_PATH=/var/lib/facturapp/facturapp.sqlite

# UF
UF_API_BASE=https://mindicador.cl/api/uf
UF_CACHE_TTL_HOURS=24

# Google (Service Account — NUNCA commitear el JSON)
GOOGLE_SA_JSON_PATH=./service-account.json
GOOGLE_SHEETS_BASE_FACTURACION_ID=1YFn9QfyIympuqS7zeF2jtfSjOTwBI184CP4mkRUB4V0
GOOGLE_SHEETS_BASE_FACTURACION_RANGE=A:O
GOOGLE_SHEETS_MASTER_FACTURACION_ID=1es6Jk8hmqwz7gcrz84jI_u8dDvfO2l9W5W5g9sf-wF4
GOOGLE_MASTER_AUTOPUSH=true
GOOGLE_SHEETS_PROYECCIONES_ID=
GOOGLE_SHEETS_PROYECCIONES_RANGE=A:Z
GOOGLE_DRIVE_PLANTILLA_FILE_ID=

# Fallback sin Service Account: importar base de facturacion desde XLSX
BASE_FACTURACION_XLSX_PATH=../archivos/base-facturacion.xlsx
BASE_FACTURACION_XLSX_SHEET=

# Slack (Fase 2/3)
SLACK_BOT_TOKEN=

# Auth (Fase 2)
AUTH_MODE=none
ADMIN_EMAILS=
