# Servidor local
PORT=3000
NODE_ENV=development
CORS_ORIGIN=true
APP_PUBLIC_URL=http://localhost:3000

# Seguridad
# En desarrollo puede ser un valor local. En produccion debe ser largo y secreto.
SESSION_SECRET=change-me-local-only

# Bootstrap opcional para crear/asegurar un admin inicial con npm run rotate:passwords.
# No versionar valores reales.
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Base de datos
# Obligatorio: el backend usa solo PostgreSQL.
DATABASE_URL=postgresql://factuflow:change-me@localhost:5432/factuflow

# UF
UF_API_BASE=https://mindicador.cl/api/uf
UF_SII_BASE=https://www.sii.cl/valores_y_fechas/uf
UF_CACHE_TTL_HOURS=24
UF_CACHE_FROM_YEAR=2026
UF_CACHE_TO_YEAR=2026

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
