# Servidor
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me

# Base de datos (Postgres recomendado; SQLite válido en fase 1)
DATABASE_URL=postgres://user:pass@localhost:5432/facturapp
# DATABASE_URL=sqlite://./storage/facturapp.sqlite

# UF
UF_API_BASE=https://mindicador.cl/api/uf
UF_CACHE_TTL_HOURS=24

# Google (Service Account — NUNCA commitear el JSON)
GOOGLE_SA_JSON_PATH=./service-account.json
GOOGLE_SHEETS_BASE_FACTURACION_ID=
GOOGLE_SHEETS_PROYECCIONES_ID=
GOOGLE_DRIVE_PLANTILLA_FILE_ID=

# Slack (Fase 2/3)
SLACK_BOT_TOKEN=

# Auth (Fase 2)
AUTH_MODE=none
ADMIN_EMAILS=
